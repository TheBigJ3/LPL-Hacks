    "intents": [
      {
        "id": "lookup",
        "label": "Look up a number or fact",
        "description": "Asks for a specific amount or fact, such as income, contributions, balances, withholding, or employer",
        "answers_from": "normalized_field",
        "examples": [
          "What was Sarah's income last year?",
          "How much did John put in his 401k?",
          "Where does Taylor work?",
          "How much cash do they have?"
        ]
      },
      {
        "id": "savings_opportunity",
        "label": "Can they save more?",
        "description": "Asks whether someone could save more or improve their retirement savings",
        "answers_from": "checklist:retirement_can_improve",
        "examples": [
          "Can Sarah make some savings?",
          "Is John maxing out his 401k?",
          "Could they be saving more for retirement?"
        ]
      },
      {
        "id": "tax_opportunity",
