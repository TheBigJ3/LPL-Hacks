PORT=3001
CORS_ORIGIN=http://localhost:5173
# Proxy hops (LB / CDN) in front of the app, or a CIDR to trust. Never "true".
RATE_LIMIT_TRUST_PROXY=1
DEV_BRANCH=false

# Auth was cut for the demo: every request acts as this advisor (services/users/userMethods.ts).
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
DEFAULT_USER_FIRST_NAME=Demo
DEFAULT_USER_LAST_NAME=Advisor
DEFAULT_USER_EMAIL=demo.advisor@example.com

# AWS SDK. Region is required; credentials resolve through the SDK's default chain:
#   1. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (/ AWS_SESSION_TOKEN) below, if set
#   2. AWS_PROFILE (~/.aws/credentials, or `aws sso login` for IAM Identity Center)
#   3. the instance/container role when deployed on AWS
# Leave the key vars blank locally if you use a profile; never set them in a deployed environment that has a role.
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Uploaded documents, kept private. Must be in AWS_REGION.
# The AWS identity above needs s3:PutObject and s3:GetObject on it, plus textract:AnalyzeDocument.
S3_DOCUMENTS_BUCKET=

# Postgres on Amazon RDS, IAM database authentication (no password; a 15-minute token is minted per connection).
# POSTGRES_USER must be a DB role granted rds_iam, and the AWS identity above needs rds-db:connect on it.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
# AWS's RDS root CA bundle (https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem), relative to backend/.
POSTGRES_CA_CERT_PATH=certs/rds-global-bundle.pem
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10
POSTGRES_JOB_POOL_MIN=1
POSTGRES_JOB_POOL_MAX=10

# Redis / Valkey (e.g. Amazon ElastiCache). Use a single-node endpoint: BullMQ
# keeps a queue's keys on one shard and does not support cluster/serverless mode.
REDIS_HOST=
REDIS_PORT=6379
# Optional. Leave blank when the cluster has no AUTH token / RBAC password.
REDIS_PASSWORD=
# Set "true" when the cluster has in-transit encryption enabled.
REDIS_TLS=false

COOKIE_SECRET=
