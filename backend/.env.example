PORT=3001
CORS_ORIGIN=http://localhost:5173
# Proxy hops (LB / CDN) in front of the app, or a CIDR to trust. Never "true".
RATE_LIMIT_TRUST_PROXY=1
DEV_BRANCH=false

# Auth was cut for the demo: every request acts as this advisor (services/users/userMethods.ts).
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
DEFAULT_USER_FIRST_NAME=Demo
DEFAULT_USER_LAST_NAME=Advisor
DEFAULT_USER_EMAIL=demo.advisor@example.com

POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL_VERIFY=true
POSTGRES_CA_CERT=
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10
POSTGRES_JOB_POOL_MIN=1
POSTGRES_JOB_POOL_MAX=10

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

TWILLIO_ACCOUNT_SID=
