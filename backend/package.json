{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "dotenv -e .env.development -v NODE_ENV=development -- tsx watch index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "dotenv -e .env.development -- tsx scripts/drizzleKit.ts push",
    "db:generate": "dotenv -e .env.development -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.development -- tsx scripts/drizzleKit.ts migrate",
    "db:studio": "dotenv -e .env.development -- tsx scripts/drizzleKit.ts studio"
  },
  "dependencies": {
    "@aws-sdk/client-textract": "^3.1146.0",
    "@aws-sdk/rds-signer": "3.1146.0",
    "@lpl-hacks/shared": "*",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.21.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
