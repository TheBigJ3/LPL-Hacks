        "description": "Asks whether taxes could be reduced or need planning",
        "answers_from": "checklist:tax_savings_possible",
        "examples": [
          "Can they save on taxes?",
          "Is there a tax issue with Pat's withdrawal?",
          "Will Sam owe tax on the side business?"
        ]
      },
      {
        "id": "cash_opportunity",
        "label": "Is cash sitting idle?",
        "description": "Asks whether extra cash could be invested or put to better use",
        "answers_from": "checklist:excess_cash",
        "examples": [
          "Do they have too much cash?",
          "Is their cash sitting idle?",
          "Should they invest some of their savings?"
        ]
      },
      {
        "id": "documents_status",
